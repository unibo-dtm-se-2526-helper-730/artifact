<?xml version="1.0" encoding="UTF-8"?>
<!-- Bug patterns that SpotBugs must not report. Keep every entry justified. -->
<FindBugsFilter
	xmlns="https://github.com/spotbugs/filter/3.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

	<!-- Spring beans keep references to the collaborators they receive in the constructor,
	     and records/DTOs hand out the lists they hold: this is by design, not a leak -->
	<Match>
		<Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
	</Match>

	<!-- Domain objects validate their arguments in the constructor and throw on invalid input -->
	<Match>
		<Bug pattern="CT_CONSTRUCTOR_THROW" />
	</Match>
</FindBugsFilter>
